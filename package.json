{
  "name": "outlet-hub-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Web client foundation for OutletHub",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test && pnpm build",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "7.0.9",
    "@tanstack/react-query": "5.108.4",
    "axios": "1.21.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.78.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-router": "8.5.2",
    "sonner": "2.0.8",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query-devtools": "5.108.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.4",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": "prettier --write"
  }
}
